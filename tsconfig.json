{
  // 自包含编译器配置：类型从 devDependencies 中的 @deepseek-ai/* npm SDK
  // 包解析（官方 NPM SDK），不从 DSH 源码 checkout 解析。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // host 半区在 src/index.ts 用 node:http 的 IncomingMessage / ServerResponse
    // （与 dsh-task-board 双半区插件对齐）；client 半区走 fetch 不需要 node
    // 类型，但加 node types 不会污染 client bundle（tsdown externals 由
    // shared/tsdown.client.ts 单独控制）。
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}